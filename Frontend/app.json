{
  "expo": {
    "name": "Carterita",
    "slug": "Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070708"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carterita.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070708"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.carterita.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Carterita usa el micrófono para que registres tus gastos dictándolos.",
          "speechRecognitionPermission": "Carterita convierte tu voz en texto para registrar tus gastos.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ]
  }
}
