# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a Git.

# Neon, rama "dev": cadena con pooling (el host contiene "-pooler"). La usa la API.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Neon, rama "dev": cadena directa (sin "-pooler"). La usa Prisma para las migraciones.
DIRECT_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Texto aleatorio largo para firmar las sesiones. Lo genera Claude; no lo compartas.
JWT_SECRET=""

PORT=3000

# Lectura de tickets y transcripción de voz desde Expo Go (D44, D45). Opcionales hasta S7-09.
OCR_SPACE_API_KEY=""
GROQ_API_KEY=""
